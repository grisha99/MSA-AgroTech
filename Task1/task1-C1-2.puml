@startuml Архитектура_АгроТех_C1_Вариант_2_Умные_Камеры

!include ../C4_Component.puml

' === Участники ===
Person(директор, "Директор хозяйства", "Управление через веб-портал")
Person(оператор, "Оператор / Дежурный фермы", "Мониторинг свинокомплекса")
Person(аналитик, "Аналитик", "Работа с BI-системой")

System_Boundary(существующая_платформа, "АгроПром Х - Существующая цифровая平台") {
    System(веб_портал, "Веб-портал / Мобильное приложение", "Интерфейсы пользователей")
    System(kafka, "Брокер сообщений (Apache Kafka)", "Центральная шина обмена данными холдинга")
    System(центральный_сервер, "Центральный сервер Животноводства", "Облачный/Головной сервис координации, управления агентами, агрегации метрик и API")
    System(erp, "ERP система (1С:Агро)", "Учет поголовья, запасов кормов")
    System(data_storage, "Хранилища данных (MinIO + ClickHouse)", "Исторические данные")
    System(bi, "BI система", "Аналитические отчеты")
    
}

System_Boundary(новое_решение_животноводство_v2, "Платформа мониторинга скота (MVP) - Вариант 2") {
    
    System_Ext(умные_камеры, "Умные видеокамеры (Smart Edge)", "Камеры со встроенным нейрочипом. Исполнение ИИ на борту, детекция инцидентов")
    System_Ext(контроллеры_иот, "IoT Оборудование свинарников", "Управление кормушками, поилками, датчики фильтрации воды")
    
    System(тонкий_агент, "Локальный шлюз фермы (Тонкий агент)", "Мини-компьютер/промышленный контроллер. Сбор текстовых алертов от камер и IoT, буферизация при офлайне")

    
}

' === Взаимосвязи ===
Rel(директор, веб_портал, "Просматривает KPI и отчеты")
Rel(оператор, тонкий_агент, "Локальные алерты < 5 сек (SMS/Локальный UI) при сбоях связи")
Rel(оператор, веб_портал, "Управление в штатном режиме")
Rel(аналитик, bi, "Строит прогнозы")

' Внутри фермы
Rel(умные_камеры, тонкий_агент, "Передача готовых метаданных о событиях (JSON/MQTT)", "LAN")
Rel(контроллеры_иот, тонкий_агент, "Телеметрия фильтров, управление кормом/водой", "Modbus/MQTT")

' Синхронизация Агент - Центр
Rel(тонкий_агент, kafka, "Синхронизация данных (задержка до 10 мин), передача метрик и алертов", "HTTPS/gRPC")
Rel(kafka, тонкий_агент, "Передача команд управления на ферму (из Kafka обратно агенту)", "Kafka Protocol")

' Интеграция с ИТ-ландшафтом АгроТех Х
Rel(центральный_сервер, kafka, "Публикация событий, метрик и инцидентов", "Kafka Protocol")
Rel(kafka, data_storage, "Сброс сырых и трансформированных данных")
Rel(kafka, веб_портал, "Передача мгновенных уведомлений")
Rel(kafka, erp, "Обновление данных по поголовью и расходу корма")
Rel(data_storage, bi, "Источник для отчетов")
Rel(центральный_сервер, kafka, "Публикует обработанные события и команды управления для ферм")

@enduml