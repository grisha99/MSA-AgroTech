@startuml Архитектура_АгроТех_C1_Вариант_1_Толстый_Агент

!include ../C4_Component.puml

' === Участники ===
Person(директор, "Директор хозяйства", "Управление через веб-портал")
Person(оператор, "Оператор / Дежурный фермы", "Мониторинг свинокомплекса на месте и удаленно")
Person(аналитик, "Аналитик", "Работа с BI-системой")

' === Единый контур Цифровой платформы Холдинга ===
System_Boundary(платформа, "АгроПром Х - Цифровая платформа (Единый контур)") {
    System(kafka, "Брокер сообщений (Apache Kafka)", "Центральная шина обмена данными холдинга")
    
    ' Новый компонент Животноводства теперь внутри платформы
    System(центральный_сервер, "Центральный сервер Животноводства", "Микросервис координации, управления агентами, агрегации метрик и бизнес-логики")
    
    System(веб_портал, "Веб-портал / Мобильное приложение", "Интерфейсы пользователей, отображение алертов Животноводства")
    System(erp, "ERP система (1С:Агро)", "Учет поголовья, запасов кормов, финансы")
    System(data_storage, "Хранилища данных (MinIO + ClickHouse)", "Исторические данные и сквозная аналитика")
    System(bi, "BI система", "Аналитические отчеты по эффективности")
}

' === Локальный контур конкретной фермы ===
System_Boundary(локальная_ферма, "Локальная ферма (Контур свинокомплекса)") {
    System_Ext(видеокамеры, "Камеры видеонаблюдения", "Обычные IP-камеры с ИК-подсветкой (RTSP-поток)")
    System_Ext(контроллеры_иот, "IoT Оборудование свинарников", "Управление кормушками, поилками, датчики фильтрации воды")
    
    System(толстый_агент, "Локальный сервер фермы (Толстый агент)", "Edge-сервер с GPU. Локальный ИИ, сбор данных, локальный буфер/очередь для офлайн-режима")
}

' === Взаимосвязи ===
Rel(директор, веб_портал, "Просматривает KPI и отчеты")
Rel(оператор, толстый_агент, "Получает локальные алерты < 5 сек при сбоях связи (напрямую с сервера фермы)")
Rel(оператор, веб_портал, "Управляет процессами в штатном режиме через UI")
Rel(аналитик, bi, "Строит прогнозы")

' Внутри фермы
Rel(видеокамеры, толстый_агент, "Стриминг видеопотока в реальном времени (RTSP)", "LAN")
Rel(контроллеры_иот, толстый_агент, "Телеметрия фильтров, управление кормом/водой", "Modbus/MQTT через LAN")

' СИНХРОНИЗАЦИЯ: Агент льет напрямую в Центральную Kafka холдинга
Rel(толстый_агент, kafka, "Публикация телеметрии, метрик и алертов (буферизация при офлайне, задержка до 10 мин)", "Kafka Protocol / TLS (WAN / 4G)")

' Внутренние интеграции в Цифровой платформе
Rel(kafka, центральный_сервер, "Потребляет (Consume) данные от ферм для обработки бизнес-логики")
Rel(центральный_сервер, kafka, "Публикует обработанные события и команды управления для ферм")
Rel(kafka, толстый_агент, "Передача команд управления на ферму (из Kafka обратно агенту)", "Kafka Protocol")

Rel(kafka, data_storage, "Сброс сырых и трансформированных данных")
Rel(kafka, веб_портал, "Передача мгновенных уведомлений операторам (WebSocket)")
Rel(kafka, erp, "Обновление данных по поголовью и расходу корма")
Rel(data_storage, bi, "Источник для отчетов")

@enduml